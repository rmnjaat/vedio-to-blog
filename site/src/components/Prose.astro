---
// Wrap rendered MDX in <Prose>. It does two things to the HTML (see src/lib/prose.ts):
// 1. h3 headings get an id (if missing), the hover "#" anchor link, and an optional rail label ([[rail: Short]]).
// 2. Coverage markers for MDX prose. Write [[L-0001 L-0002]] at the end of a paragraph, list item, heading,
// table cell or quote: the marker is removed and its ids are added to that element's data-k attribute.
// Components take a `k` prop instead. scripts/coverage.mjs reads every data-k in the built pages.
// Lecture pages use DocsShell, which does the same processing and also builds the "On this page" index.
import { processProse } from '../lib/prose';
const out = processProse(await Astro.slots.render('default'));
---
<Fragment set:html={out} />
