---
// A named aside the reader may skip: title + a one-line reason to skip it, body collapsed.
interface Props { title: string; why?: string; open?: boolean; k?: string }
const { title, why, open = false, k } = Astro.props;
---
<details class="aside" open={open} data-k={k}>
  <summary>{title} {why && <span class="why hand">{why}</span>}</summary>
  <div class="body"><slot /></div>
</details>
