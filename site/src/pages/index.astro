---
// Course home: the lectures in course order (lectures/course.json; numbers are course positions).
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { COURSE, LECTURES, pad } from '../data/course';
import { url } from '../lib/url';

const written = new Map((await getCollection('lectures')).map((e) => [e.id, e]));
---
<Layout title={COURSE.title} description={COURSE.subtitle} here={COURSE.title}>
  <div class="col lecture home">
    <p class="kicker hand">A notebook of a live cohort class · running case: Medium</p>
    <h1>{COURSE.title}</h1>
    <p class="dek">{COURSE.subtitle}</p>
    <ol class="lectures">
      {LECTURES.map((l) => {
        const e = written.get(l.id);
        return (
          <li class:list={[!e && 'dim']}>
            <span class="no hand">{pad(l.number)}</span>
            {e ? (
              <span>
                <a href={url(`lectures/${l.id}/`)}>{e.data.title}</a>
                {e.data.status === 'draft' && <span class="tag hand"> draft</span>}
                <span class="lec-dek">{l.promise ?? e.data.dek}</span>
              </span>
            ) : (
              <span><span class="pending">{l.title ?? `Lecture ${l.number}`}</span><span class="lec-dek hand">{l.promise ? `${l.promise} · ` : ''}in preparation</span></span>
            )}
          </li>
        );
      })}
    </ol>
  </div>
</Layout>
