---
// Course home: the ten lectures in course order.
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { COURSE, LECTURES, pad } from '../data/course';

const written = new Map((await getCollection('lectures')).map((e) => [e.id, e]));
---
<Layout title={COURSE.title} description={COURSE.subtitle} here={COURSE.title}>
  <div class="col lecture home">
    <p class="kicker hand">A notebook of a live cohort class · running case: Medium</p>
    <h1>{COURSE.title}</h1>
    <p class="dek">{COURSE.subtitle}</p>
    <ol class="lectures">
      {LECTURES.map((l) => {
        const e = written.get(l.id);
        return (
          <li class:list={[!e && 'dim']}>
            <span class="no hand">{pad(l.number)}</span>
            {e ? (
              <span>
                <a href={`/lectures/${l.id}/`}>{e.data.title}</a>
                {e.data.status === 'draft' && <span class="tag hand"> draft</span>}
                <span class="lec-dek">{e.data.dek}</span>
              </span>
            ) : (
              <span><span class="pending">Lecture {pad(l.number)}</span><span class="lec-dek hand">in preparation</span></span>
            )}
          </li>
        );
      })}
    </ol>
    <p class="hand demo-links">Design check: <a href="/demo/">§2.4 rebuilt from the components</a> · <a href="/demo/animation/">clip demo</a></p>
  </div>
</Layout>
