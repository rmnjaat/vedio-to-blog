---
// Lecture page template: one page per lecture, driven by src/content/lectures/<id>.mdx.
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import LectureHeader from '../../components/LectureHeader.astro';
import Prose from '../../components/Prose.astro';
import { COURSE, pad } from '../../data/course';

export async function getStaticPaths() {
  const lectures = await getCollection('lectures');
  return lectures.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const contents = d.contents.map((c) => ({ ...c, dim: !c.href && !c.children?.some((x) => x.href), children: c.children?.map((x) => ({ ...x, dim: !x.href })) }));
const meta: (string | { label: string; href: string })[] = ['From a live whiteboard class'];
if (d.reviewed) meta.push(`Last reviewed ${d.reviewed}`);
meta.push({ label: 'Found an error?', href: '#' });
const first = d.contents.flatMap((c) => [c, ...(c.children ?? [])]).find((c) => c.href);
---
<Layout title={`${d.title} · Lecture ${pad(d.number)}`} description={d.description}
  crumbs={[{ label: COURSE.title, href: '/', opt: true }, { label: `Lecture ${pad(d.number)}`, href: '#main' }]}
  here={first ? `${first.no} ${first.title}` : d.title} sections>
  <LectureHeader kicker={d.kicker} title={d.title} dek={d.dek} meta={meta} contents={contents} />
  <Prose><Content /></Prose>
  <div class="col"><footer class="page hand">Lecture {pad(d.number)} · written from the class recording and board, with sources linked where a fact comes from outside the class.</footer></div>
</Layout>
