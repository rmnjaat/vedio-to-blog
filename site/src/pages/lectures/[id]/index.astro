---
// Lecture overview: /lectures/<id>/. Title, promise (dek), meta, the chapter list with one-line summaries, then
// the lecture body (src/content/lectures/<id>.mdx: the header block, e.g. "About this class" and "Medium so far").
// A lecture without `chapters` in its frontmatter is one page: its body is the whole lecture.
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import DocsShell from '../../../components/DocsShell.astro';
import LectureHeader from '../../../components/LectureHeader.astro';
import ChapterList from '../../../components/ChapterList.astro';
import Pager from '../../../components/Pager.astro';
import { COURSE, pad, numberOf, kickerOf } from '../../../data/course';
import { chaptersOf, courseNav, lectureHref, resolver, around } from '../../../lib/lecture';

export async function getStaticPaths() {
  const lectures = await getCollection('lectures');
  return lectures.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const num = numberOf(entry.id, d.number); // course position (lectures/course.json)
const { Content } = await render(entry);
const chapters = chaptersOf(entry);
const nav = await courseNav();
const href = lectureHref(entry.id);
const { prev, next } = around(nav, href);
const meta: (string | { label: string; href: string })[] = [d.origin ?? 'From a live whiteboard class'];
if (d.reviewed) meta.push(`Last reviewed ${d.reviewed}`);
meta.push({ label: 'Found an error?', href: '#' });
// a one-page lecture keeps the old "Contents of this lecture" block (hrefs are section ids on this page)
const contents = chapters.length ? undefined
  : d.contents.map((c) => ({ ...c, dim: !c.href && !c.children?.some((x) => x.href), children: c.children?.map((x) => ({ ...x, dim: !x.href })) }));
---
<Layout title={`${d.title} · Lecture ${pad(num)}`} description={d.description} docs
  crumbs={[{ label: COURSE.title, href: '/', opt: true }]} here={`Lecture ${pad(num)}`}>
  <DocsShell nav={nav} lecture={entry.id} href={href} resolve={resolver(entry)}
    lead={chapters.length ? [{ id: 'toc', label: 'Chapters' }] : []}>
    <Fragment slot="head">
      <LectureHeader kicker={kickerOf(entry.id, d.kicker, d.number)} title={d.title} dek={d.dek} meta={meta} contents={contents}>
        {chapters.length > 0 && <ChapterList chapters={chapters} />}
      </LectureHeader>
    </Fragment>
    <Content />
    <Fragment slot="foot">
      <Pager prev={prev} next={next && { ...next, label: next.kind === 'chapter' ? 'Start reading' : next.label }} />
      <div class="col"><footer class="page hand">Lecture {pad(num)} · {d.footnote ?? 'written from the class recording and board, with sources linked where a fact comes from outside the class.'}</footer></div>
    </Fragment>
  </DocsShell>
</Layout>
